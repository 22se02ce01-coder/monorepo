{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "1-pdf-tools": {
      "root": "01-PDF-Tools",
      "framework": "vite"
    },
    "2-image-to-pdf": {
      "root": "02-Image-to-PDF",
      "framework": "vite"
    },
    "3-pdf-to-word": {
      "root": "03-PDF-to-Word",
      "framework": "vite"
    },
    "4-image-compressor": {
      "root": "04-Image-Compressor",
      "framework": "vite"
    },
    "5-image-resizer": {
      "root": "05-Image-Resizer",
      "framework": "vite"
    },
    "6-image-converter": {
      "root": "06-Image-Converter",
      "framework": "vite"
    },
    "7-json-formatter": {
      "root": "07-JSON-Formatter",
      "framework": "vite"
    },
    "8-base64-tools": {
      "root": "08-Base64-Tools",
      "framework": "vite"
    },
    "9-jwt-decoder": {
      "root": "09-JWT-Decoder",
      "framework": "vite"
    },
    "0-developer-toolbox": {
      "root": "10-Developer-Toolbox",
      "framework": "vite"
    },
    "1-percentage-calculator": {
      "root": "11-Percentage-Calculator",
      "framework": "vite"
    },
    "2-age-calculator": {
      "root": "12-Age-Calculator",
      "framework": "vite"
    },
    "3-emi-calculator": {
      "root": "13-EMI-Calculator",
      "framework": "vite"
    },
    "4-gst-calculator": {
      "root": "14-GST-Calculator",
      "framework": "vite"
    },
    "5-qr-generator": {
      "root": "15-QR-Generator",
      "framework": "vite"
    },
    "6-password-generator": {
      "root": "16-Password-Generator",
      "framework": "vite"
    },
    "7-text-converter": {
      "root": "17-Text-Converter",
      "framework": "vite"
    },
    "8-unit-converter": {
      "root": "18-Unit-Converter",
      "framework": "vite"
    },
    "9-currency-converter": {
      "root": "19-Currency-Converter",
      "framework": "vite"
    },
    "0-time-zone-converter": {
      "root": "20-Time-Zone-Converter",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/pdf-tools/(.*)",
      "destination": {
        "service": "1-pdf-tools"
      }
    },
    {
      "source": "/image-to-pdf/(.*)",
      "destination": {
        "service": "2-image-to-pdf"
      }
    },
    {
      "source": "/pdf-to-word/(.*)",
      "destination": {
        "service": "3-pdf-to-word"
      }
    },
    {
      "source": "/image-compressor/(.*)",
      "destination": {
        "service": "4-image-compressor"
      }
    },
    {
      "source": "/image-resizer/(.*)",
      "destination": {
        "service": "5-image-resizer"
      }
    },
    {
      "source": "/image-converter/(.*)",
      "destination": {
        "service": "6-image-converter"
      }
    },
    {
      "source": "/json-formatter/(.*)",
      "destination": {
        "service": "7-json-formatter"
      }
    },
    {
      "source": "/base64-tools/(.*)",
      "destination": {
        "service": "8-base64-tools"
      }
    },
    {
      "source": "/jwt-decoder/(.*)",
      "destination": {
        "service": "9-jwt-decoder"
      }
    },
    {
      "source": "/developer-toolbox/(.*)",
      "destination": {
        "service": "0-developer-toolbox"
      }
    },
    {
      "source": "/percentage-calculator/(.*)",
      "destination": {
        "service": "1-percentage-calculator"
      }
    },
    {
      "source": "/age-calculator/(.*)",
      "destination": {
        "service": "2-age-calculator"
      }
    },
    {
      "source": "/emi-calculator/(.*)",
      "destination": {
        "service": "3-emi-calculator"
      }
    },
    {
      "source": "/gst-calculator/(.*)",
      "destination": {
        "service": "4-gst-calculator"
      }
    },
    {
      "source": "/qr-generator/(.*)",
      "destination": {
        "service": "5-qr-generator"
      }
    },
    {
      "source": "/password-generator/(.*)",
      "destination": {
        "service": "6-password-generator"
      }
    },
    {
      "source": "/text-converter/(.*)",
      "destination": {
        "service": "7-text-converter"
      }
    },
    {
      "source": "/unit-converter/(.*)",
      "destination": {
        "service": "8-unit-converter"
      }
    },
    {
      "source": "/currency-converter/(.*)",
      "destination": {
        "service": "9-currency-converter"
      }
    },
    {
      "source": "/time-zone-converter/(.*)",
      "destination": {
        "service": "0-time-zone-converter"
      }
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/pdf-tools/",
      "permanent": false
    }
  ]
}